# ==============================================================================
# THE TOUR VISION - ENVIRONMENT VARIABLES
# ==============================================================================
# Note: Copy this file to .env.local and fill in the appropriate credentials.
# NEVER commit .env.local or sensitive keys to source control.

# Application Information
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="The Tour Vision"
NEXT_PUBLIC_ENABLE_DEMO_BADGE=true

# Supabase Configuration
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: Service role key for admin tasks, elevated DB routines, etc.
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Email Integration
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM="The Tour Vision <concierge@thetourvision.com>"
ADMIN_NOTIFICATION_EMAIL=admin@thetourvision.com

# AI Provider Configuration (Google Gemini / Anthropic / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyD...

# Meta / WhatsApp Cloud API Integration
# Obtain from Meta for Developers -> WhatsApp App Dashboard
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=10987654321
WHATSAPP_VERIFY_TOKEN=tour_vision_secure_webhook_token_2026
WHATSAPP_APP_SECRET=abcdef1234567890abcdef
# Fallback click-to-chat phone number (with country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE=919876543210

# Google Maps API (Optional: For interactive maps & geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...
